mod context
mod module
mod types
mod values
mod function
mod builder
mod execution_engine

fn build_sum_module(ctx: context::Context) -> module::Module is
    let m: module::Module = ctx.create_module("hello_sum")

    let i32_ty: types::Type = ctx.i32_type()
    let fn_ty: types::Type = i32_ty.fn_type([i32_ty, i32_ty], false)
    let sum_fn: function::FunctionValue = m.add_function("sum", fn_ty)

    let entry: basic_block::BasicBlock = sum_fn.append_basic_block(ctx, "entry")
    let b: builder::Builder = ctx.create_builder()
    b.position_at_end(entry)

    let a: values::Value = sum_fn.get_param(0)
    let bb: values::Value = sum_fn.get_param(1)
    let result: values::Value = b.build_add(a, bb, "result")
    b.build_ret(result)
    b.dispose()

    return m
end

fn main() is
    let ctx: context::Context = context::Context::create()
    let m: module::Module = build_sum_module(ctx)

    write("=== LLVM IR ===")
    write(m.print_to_string())

    if m.is_valid() is
        write("=== Moduł poprawny ===")
    else
        write("=== BŁĄD WERYFIKACJI ===")
        write(m.verify())
        return
    end

    ;; JIT: uruchamiamy sum(2, 40) reflektywnie przez interpreter LLVM-a —
    ;; patrz komentarz na górze src/execution_engine.h# po wyjaśnienie
    ;; dlaczego akurat tak (a nie "prawdziwym" wskaźnikiem funkcyjnym).
    execution_engine::ExecutionEngine::link_in_mcjit()
    let ee = execution_engine::ExecutionEngine::create_for_module(m)
    if ee == nil is
        write("Nie udało się utworzyć ExecutionEngine: " + obsidian_last_error())
        return
    end

    let sum_fn: function::FunctionValue = m.get_function("sum")
    let i32_ty: types::Type = ctx.i32_type()
    let arg_a: execution_engine::GenericValue = execution_engine::GenericValue::of_int(i32_ty, 2, true)
    let arg_b: execution_engine::GenericValue = execution_engine::GenericValue::of_int(i32_ty, 40, true)
    let result: execution_engine::GenericValue = ee.run_function(sum_fn, [arg_a, arg_b])

    write("=== Wynik JIT ===")
    write("sum(2, 40) = " + to_string(result.to_int_signed()))

    result.dispose()
    arg_a.dispose()
    arg_b.dispose()
    ee.dispose() ;; zwalnia też `m` — moduł jest już własnością silnika
    ctx.dispose()
end
