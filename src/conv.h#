pub fn handles_to_types(items: [int]) -> [types::Type] is
    let mut out: [types::Type] = []
    let mut i: int = 0
    while i < items.len() is
        let h: int = items[i]
        out.push(types::Type { handle: h })
        i = i + 1
    end
    return out
end

