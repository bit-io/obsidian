mod types
mod values
mod basic_block
pub fn types_to_handles(items: [types::Type]) -> [int] is
    let mut out: [int] = []
    let mut i: int = 0
    while i < items.len() is
        let item: types::Type = items[i]
        out.push(item.handle)
        i = i + 1
    end
    return out
end

