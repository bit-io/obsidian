mod ffi
mod conv
mod types
mod values
mod basic_block
mod context

struct FunctionValue is
    pub handle: int
end

impl FunctionValue is
    ;; Rzutowanie w górę do ogólnego `Value` (np. żeby przekazać funkcję
    ;; jako argument callback-a albo zapisać do zmiennej `[int]` z
    ;; conv::values_to_handles).
    fn as_value(self) -> values::Value is
        return values::Value { handle: self.handle }
    end

    fn get_type(self) -> types::Type is
        return types::Type { handle: LLVMTypeOf(self.handle) }
    end

    ;; Typ FUNKCJI (np. `i32 (i32, ptr)`) - odpowiednik `inkwell::FunctionValue::get_type()`. NIE mylic z `get_type()`,
    ;; ktore (LLVMTypeOf) zwraca `ptr`: `param_types()`/`build_call` na nim to UB (segfault).
    fn function_type(self) -> types::Type is
        return types::Type { handle: LLVMGlobalGetValueType(self.handle) }
    end

    fn get_name(self) -> string is
        return LLVMGetValueName2(self.handle)
    end
    fn set_name(self, name: string) is
        LLVMSetValueName2(self.handle, name, string_len(name))
    end

    fn print(self) -> string is
        return LLVMPrintValueToString(self.handle)
    end

    fn set_call_conv(self, cc: int) is
        LLVMSetFunctionCallConv(self.handle, cc)
    end
    fn call_conv(self) -> int is
        return LLVMGetFunctionCallConv(self.handle)
    end
    fn set_linkage(self, linkage: i32) is
        LLVMSetLinkage(self.handle, linkage)
    end

    ;; Atrybut wyliczeniowy (bez wartosci) po nazwie, np. "nounwind", "nonnull", "noundef".
    ;; `index`: ATTR_INDEX_FUNCTION (-1 jako u32 = 4294967295) dla funkcji, 0 = wartosc zwracana,
    ;; 1.. = parametry (numeracja LLVM: parametr i ma indeks i+1). Zwraca `false` dla nieznanej nazwy.
    fn add_enum_attribute(self, ctx: context::Context, name: string, index: u32) -> bool is
        let kind: u32 = LLVMGetEnumAttributeKindForName(name, name.len())
        if kind == 0 is return false end
        LLVMAddAttributeAtIndex(self.handle, index, LLVMCreateEnumAttribute(ctx.handle, kind, 0))
        return true
    end
    fn mark_nounwind(self, ctx: context::Context) -> bool is
        return self.add_enum_attribute(ctx, "nounwind", 4294967295)
    end
    ;; Odpowiednik `llvm_optimize::mark_param_nonnull`: `noundef` + `nonnull` na parametrze `param_index` (od 0).
    fn mark_param_nonnull(self, ctx: context::Context, param_index: int) -> bool is
        let idx: u32 = param_index + 1
        let a: bool = self.add_enum_attribute(ctx, "nonnull", idx)
        let b: bool = self.add_enum_attribute(ctx, "noundef", idx)
        return a && b
    end

    ;; ── Parametry ────────────────────────────────────────────────────
    fn param_count(self) -> int is
        return LLVMCountParams(self.handle)
    end
    fn get_param(self, idx: int) -> values::Value is
        return values::Value { handle: LLVMGetParam(self.handle, idx) }
    end
    ;; Wszystkie parametry naraz, w kolejności deklaracji.
    fn params(self) -> [values::Value] is
        return conv::handles_to_values(obsidian_get_params(self.handle))
    end

    ;; ── Podstawowe bloki ─────────────────────────────────────────────
    fn append_basic_block(self, ctx: context::Context, name: string) -> basic_block::BasicBlock is
        return basic_block::BasicBlock { handle: LLVMAppendBasicBlockInContext(ctx.handle, self.handle, name) }
    end
    fn insert_basic_block_before(self, ctx: context::Context, before: basic_block::BasicBlock, name: string) -> basic_block::BasicBlock is
        return basic_block::BasicBlock { handle: LLVMInsertBasicBlockInContext(ctx.handle, before.handle, name) }
    end
    fn entry_block(self) -> basic_block::BasicBlock? is
        let h: int = LLVMGetEntryBasicBlock(self.handle)
        if h == 0 is return nil end
        return basic_block::BasicBlock { handle: h }
    end
    fn first_block(self) -> basic_block::BasicBlock? is
        let h: int = LLVMGetFirstBasicBlock(self.handle)
        if h == 0 is return nil end
        return basic_block::BasicBlock { handle: h }
    end
    fn basic_block_count(self) -> int is
        return LLVMCountBasicBlocks(self.handle)
    end
    ;; Wszystkie bloki w kolejności — przydatne do pełnego przejścia po
    ;; ciele funkcji (np. własny analizator/optymalizacja na poziomie H#).
    fn basic_blocks(self) -> [basic_block::BasicBlock] is
        let mut out: [basic_block::BasicBlock] = []
        let mut cur: int = LLVMGetFirstBasicBlock(self.handle)
        while cur != 0 is
            out.push(basic_block::BasicBlock { handle: cur })
            cur = LLVMGetNextBasicBlock(cur)
        end
        return out
    end

    ;; Usuwa CIAŁO I deklarację funkcji z modułu.
    fn delete(self) is
        LLVMDeleteFunction(self.handle)
    end

    ;; Zwraca `nil` jeśli funkcja jest poprawna, w przeciwnym razie krótki
    ;; opis (dla pełnego komunikatu diagnostycznego użyj Module::verify).
    fn verify(self) -> string? is
        let msg: string = obsidian_verify_function(self.handle)
        if msg == "" is return nil end
        return msg
    end

    fn eq(self, other: function::FunctionValue) -> bool is
        return self.handle == other.handle
    end
end
